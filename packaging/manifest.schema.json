{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step 05.09 packaged artifact inventory",
  "type": "object",
  "required": [
    "manifestVersion",
    "runtimeVersion",
    "platform",
    "arch",
    "artifacts",
    "packageVersion",
    "appVersion",
    "apiVersion",
    "engineVersion",
    "nodeVersion",
    "modelId",
    "origin",
    "target"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "runtimeVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "platform": {
      "enum": [
        "linux",
        "darwin",
        "win32"
      ]
    },
    "arch": {
      "enum": [
        "x64",
        "arm64"
      ]
    },
    "build": {
      "type": "object",
      "description": "Compiler/CMake versions, source revisions, patches, flags, dependency inventory and reproducibility evidence"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
          },
          "kind": {
            "enum": [
              "executable",
              "model",
              "library",
              "frontend",
              "runtime",
              "license",
              "metadata"
            ]
          },
          "path": {
            "type": "string",
            "description": "Relative, non-symlink package-owned path; checked by artifactManifest.mjs"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha1": {
            "type": "string",
            "description": "Optional upstream provenance; never a replacement for SHA-256"
          },
          "source": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        }
      }
    },
    "packageVersion": {
      "const": 1
    },
    "appVersion": {
      "const": "0.1.0"
    },
    "apiVersion": {
      "const": 1
    },
    "engineVersion": {
      "const": "1.8.3"
    },
    "nodeVersion": {
      "const": "24.21.0"
    },
    "modelId": {
      "const": "base.en"
    },
    "origin": {
      "const": "http://127.0.0.1:8765"
    },
    "target": {
      "enum": [
        "linux-x64",
        "windows-x64",
        "macos-x64",
        "macos-arm64"
      ]
    }
  },
  "$comment": "Launcher must authenticate this manifest, require Node/whisper-cli/ffmpeg/ffprobe/active model plus dependency/frontend inventory, and verify target/runtime identity before using it. This schema is not a shipped signed manifest."
}
