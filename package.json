{
  "name": "estudos-pte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "runtime:stress:restart": "node tools/runtime-hardening/restart-stress.mjs",
    "runtime:stress:transcribe": "node tools/runtime-hardening/transcription-stress.mjs",
    "runtime:stress:slow": "node tools/runtime-hardening/slow-client.mjs",
    "runtime:audit:network": "node tools/runtime-hardening/network-audit.mjs",
    "benchmark:speech": "node tools/speech-benchmark/benchmark.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs runtime/tests/*.test.mjs",
    "runtime:start": "node runtime/src/main.mjs",
    "runtime:test": "node --test runtime/tests/*.test.mjs",
    "preview": "vite preview",
    "test:speech-browser": "node tests/speech-react-browser.mjs",
    "dev:stt-poc": "vite --config tools/local-stt/vite.config.ts",
    "test:speech-migration": "node tests/speech-migration-browser.mjs",
    "package:test": "node --test packaging/tests/*.test.mjs",
    "package:launchers": "node packaging/build-launchers.mjs",
    "package:linux": "node packaging/build-linux.mjs",
    "package:windows": "node packaging/build-windows.mjs",
    "package:macos": "node packaging/build-macos.mjs",
    "package:smoke": "node packaging/smoke.mjs",
    "validation:speech:integrity": "node tools/runtime-validation/integrity.mjs",
    "validation:speech:runtime": "node tools/runtime-validation/runtime.mjs",
    "validation:speech:browser": "node tools/runtime-validation/browser.mjs",
    "validation:speech:http": "node tools/runtime-validation/http.mjs",
    "validation:speech:offline": "node tools/runtime-validation/offline.mjs",
    "validation:speech:resources": "node tools/runtime-validation/resources.mjs",
    "validation:speech:report": "node tools/runtime-validation/report.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
